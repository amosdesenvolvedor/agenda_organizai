# Copie para deploy.env. Esse arquivo é ignorado pelo Git.
APP_DOMAIN=agenda.seudominio.com
LETSENCRYPT_EMAIL=voce@example.com

REPOSITORY_URL=git@github.com:amosdesenvolvedor/agenda_organizai.git
DEPLOY_BRANCH=main
APP_USER=agenda
APP_GROUP=agenda
APP_DIR=/opt/agenda-organizai
APP_PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agenda_organizai
DB_USER=agenda_organizai
DB_PASSWORD=troque-por-uma-senha-forte-sem-aspas

# Gere cada segredo com: openssl rand -hex 48
JWT_ACCESS_SECRET=troque-por-um-segredo-diferente-com-mais-de-32-caracteres
JWT_REFRESH_SECRET=troque-por-outro-segredo-diferente-com-mais-de-32-caracteres

EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Agenda OrganizaI <no-reply@seudominio.com>"

# OAuth Google: callback https://seu-dominio.com/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth Microsoft: callback https://seu-dominio.com/api/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Web Push para notificações em celular e desktop
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@organizai.cloud
